# Copia este archivo a .env y llena los valores. Nunca subas .env al repositorio.

# MySQL o TiDB. Ejemplo: mysql://usuario:contraseña@host:3306/onnex_test
DATABASE_URL=
# true para conectarse con TLS (TiDB Cloud lo activa solo al detectar tidbcloud.com)
DATABASE_SSL=false
# Aplica las migraciones de drizzle/ al iniciar el servidor (true por defecto)
DB_AUTO_MIGRATE=true

# Clave de API de Resend (https://resend.com/api-keys). Empieza con re_
RESEND_API_KEY=
# Remitente. Debe ser de un dominio verificado en Resend, por ejemplo:
# EMAIL_FROM="Onnex Test <reportes@tudominio.com>"
# Si se deja vacío se usa onboarding@resend.dev, que SOLO puede enviar al correo dueño de la cuenta de Resend.
EMAIL_FROM=

# Opcional: ruta a Chrome/Chromium si no se usa el que descarga Puppeteer (en Docker: /usr/bin/chromium)
PUPPETEER_EXECUTABLE_PATH=

# Contraseña del panel /admin donde se generan los códigos de acceso. Usa una larga y difícil de adivinar.
# Si se deja vacía, el panel queda desactivado.
ADMIN_PASSWORD=

PORT=3000
# Número de proxies delante del servidor (para obtener la IP real en el límite de envíos)
TRUST_PROXY=1
